{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cekcok Kroma",
  "version": "0.1.0",
  "identifier": "com.cekcok.kroma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cekcok Kroma",
        "width": 1280,
        "height": 800,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1MDU1M0JFMTdEQkFDQTQKUldTa3JOc1h2bE1GcFhFVjZ6WVFEZTlLUDl6OW1YNzJ1bnVHMmE0Z1hTWDMrMWlRNGJqTHlRcXMK",
      "endpoints": ["https://releases.cekcok.my.id/cekcok-releases/kroma-latest.json"]
    }
  }
}
